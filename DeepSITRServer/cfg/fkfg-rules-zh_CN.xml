                    <rule name="R-1-2" enable="1" level="1" checker="check-stack-buffer-size" description="写入堆栈数组前，检查堆栈数组大小"/>
                </rules>
            </section>
        </package>
        <package name="C 规范" enable="1" expand="0">
            <section name="自定义规则" enable="1" checker="code" expand="0">
                <rules name="Required" enable="1" type="required" expand="0">
                    <rule name="R-2-1" enable="1" level="1" checker="" description="All functions shall have a cyclomatic complexity number of 20 or less."/>
                </rules>
            </section>
        </package>

    </standard>
